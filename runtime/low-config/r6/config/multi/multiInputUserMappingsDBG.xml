    </mapping>
	
	<!-- SCENES DEV MODE CUSTOMS -->
	<buttonGroup id="ShouldersAndTriggers" >
        <button id="IK_Pad_LeftShoulder" />
		<button id="IK_Pad_RightShoulder" />
    </buttonGroup>
	
	<mapping name="DevMode_Toggle" type="Button" >
		<button id="ShouldersAndTriggers" />
	</mapping >
	
	<mapping name="DevMode_Resume" type="Button" >
		<button id="IK_Pad_A_CROSS" />
	</mapping >
	
	<preset 		name="invertRelative" 
					invertRealAxis="false"
					invertFakeAxis="false"
					invertRelative="true" />
	
