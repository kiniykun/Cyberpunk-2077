	<buttonGroup id="BothThumbs" >
        <button id="IK_Pad_LeftThumb" />
        <button id="IK_Pad_RightThumb" />
    </buttonGroup>
	
	<mapping name="ActivateFreeCam" type="Button" >
		<button id="IK_F3" />
		<button id="BothThumbs" />
	</mapping >
	
	<mapping name="SwitchFreeCamControl" type="Button" >
		<button id="IK_F4" />
	</mapping>>

