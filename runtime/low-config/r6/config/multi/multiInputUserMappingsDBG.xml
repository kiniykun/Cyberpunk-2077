	<mapping name="CameraDebugStepFrame" type="Axis" >
        <button id="IK_NumPad9" val="1.0" />
        <button id="IK_NumPad8" val="-1.0" />
    </mapping>
	
	<mapping name="CameraDebugStepTrack" type="Axis" >
        <button id="IK_NumPad4" val="1.0" />
